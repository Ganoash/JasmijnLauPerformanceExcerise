<?xml version="1.0"?>
<ruleset name="Lau Performance Training">
	<description>PHP_CodeSniffer rules for the Lau Performance Training plugin.</description>
	<file>lau-performance-training.php</file>
	<file>includes</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
